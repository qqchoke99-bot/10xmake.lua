{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "enabled": { "type": "boolean", "title": "Enable Sound Physics", "default": true },
    "debug_logging": { "type": "boolean", "title": "Debug Logging", "default": true },

    "attenuation_enabled": { "type": "boolean", "title": "Attenuation", "default": true },
    "air_absorption_enabled": { "type": "boolean", "title": "Air Absorption (Lowpass)", "default": true },
    "sound_occlusion_enabled": { "type": "boolean", "title": "Sound Occlusion", "default": true },
    "volume_occlusion_enabled": { "type": "boolean", "title": "Volume Occlusion", "default": true },
    "room_reverb_enabled": { "type": "boolean", "title": "Room Reverb", "default": true },
    "echo_enabled": { "type": "boolean", "title": "Echo", "default": true },
    "speed_of_sound_enabled": { "type": "boolean", "title": "Speed of Sound Delay", "default": true },

    "attenuation_factor": { "type": "number", "minimum": 0.1, "maximum": 3.0, "default": 1.35, "title": "Attenuation Factor" },
    "air_absorption": { "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 0.85, "title": "Air Absorption" },
    "max_occlusion": { "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 0.92, "title": "Max Occlusion" },
    "occlusion_intensity": { "type": "number", "minimum": 0.0, "maximum": 3.0, "default": 1.25, "title": "Occlusion Intensity" },
    "volume_occlusion_intensity": { "type": "number", "minimum": 0.0, "maximum": 3.0, "default": 1.0, "title": "Volume Occlusion Intensity" },
    "reverb_gain": { "type": "number", "minimum": 0.0, "maximum": 3.0, "default": 1.40, "title": "Reverb Gain" },
    "reverb_brightness": { "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 0.55, "title": "Reverb Brightness" },
    "reverb_distance": { "type": "number", "minimum": 0.1, "maximum": 3.0, "default": 1.15, "title": "Reverb Distance Scale" },
    "echo_intensity": { "type": "number", "minimum": 0.0, "maximum": 3.0, "default": 1.0, "title": "Echo Intensity" },
    "speed_of_sound": { "type": "number", "minimum": 50.0, "maximum": 1000.0, "default": 343.0, "title": "Speed of Sound (blocks/s)" },
    "max_travel_delay_sec": { "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 0.45, "title": "Max Travel Delay (sec)" },
    "max_sound_processing_distance": { "type": "number", "minimum": 16.0, "maximum": 128.0, "default": 72.0, "title": "Max Processing Distance" },
    "ref_distance": { "type": "number", "minimum": 1.0, "maximum": 32.0, "default": 8.0, "title": "Reference Distance" },
    "global_intensity": { "type": "number", "minimum": 0.1, "maximum": 3.0, "default": 1.25, "title": "Global Intensity" }
  }
}
